{
  "name": "otools-puter-documents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documents (HeyPuter/everything) as an OTools plugin: the same editor, with documents stored as plain files on this computer instead of in a Puter cloud account.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "check-upstream": "node scripts/sync-upstream.mjs --check",
    "tree": "node scripts/build.mjs --tree",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/test.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "verify": "node scripts/verify-plugin.mjs",
    "i18n-report": "node scripts/i18n-report.mjs",
    "release": "node scripts/build.mjs && node scripts/pack-plugin.mjs && node scripts/verify-plugin.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.14.1",
    "bidi-js": "1.0.3",
    "fflate": "0.8.3",
    "hast-util-to-html": "9.0.5",
    "lucide": "^1.34.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm": "3.0.0",
    "nspell": "2.1.5",
    "opentype.js": "2.0.0",
    "rtf.js": "3.0.9",
    "utif": "3.1.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "commonmark": "0.31.2",
    "jsdom": "30.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
